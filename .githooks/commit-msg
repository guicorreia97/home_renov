#!/bin/sh
# Validates the commit message against docs/git-guide.md:
#   - Conventional Commits subject, known type and scope, under 72 chars
#   - a `Change:` trailer naming an OpenSpec change, on feat/** branches
#
# Prose in a doc drifts from practice silently; this fails at the moment the
# drift happens. Extend the type/scope lists here and in docs/git-guide.md
# together — a hook stricter than the doc is a trap.
set -e

MSG_FILE="$1"
TYPES="feat|fix|refactor|test|docs|chore|perf"
SCOPES="api|services|repositories|models|logging|config|tests|frontend|harness|openspec|design|ci"

# Strip comments and trailing blank lines; the subject is the first line left.
SUBJECT=$(grep -v '^#' "$MSG_FILE" | sed '/./,$!d' | head -n 1)

# Merges, reverts, fixups and squashes are generated by git or rewritten later.
case "$SUBJECT" in
	Merge\ *|Revert\ *|fixup!\ *|squash!\ *|amend!\ *) exit 0 ;;
esac

die() {
	echo "commit-msg: $1" >&2
	echo >&2
	echo "  subject: $SUBJECT" >&2
	echo "  see docs/git-guide.md" >&2
	exit 1
}

if ! printf '%s' "$SUBJECT" | grep -qE "^($TYPES)(\([a-z]+\))?!?: .+"; then
	die "subject is not Conventional Commits.
  expected: <type>(<scope>): <subject>
  types:    $(printf '%s' "$TYPES" | tr '|' ' ')"
fi

SCOPE=$(printf '%s' "$SUBJECT" | sed -n 's/^[a-z]*(\([a-z]*\)).*/\1/p')
if [ -n "$SCOPE" ] && ! printf '%s' "$SCOPE" | grep -qE "^($SCOPES)$"; then
	die "unknown scope '$SCOPE'.
  scopes: $(printf '%s' "$SCOPES" | tr '|' ' ')"
fi

if [ "${#SUBJECT}" -gt 72 ]; then
	die "subject is ${#SUBJECT} characters; the limit is 72."
fi

case "$SUBJECT" in
	*.) die "subject ends with a period; drop it." ;;
esac

# The branch name. HEAD is detached while a rebase replays commits, so fall
# back to the branch being rebased — otherwise every reworded commit skips the
# trailer check exactly when a trailer is easiest to drop.
branch_name() {
	git symbolic-ref --quiet --short HEAD 2>/dev/null && return 0
	git_dir=$(git rev-parse --git-dir)
	for f in "$git_dir/rebase-merge/head-name" "$git_dir/rebase-apply/head-name"; do
		[ -f "$f" ] && sed 's|^refs/heads/||' "$f" && return 0
	done
	echo ""
}

BRANCH=$(branch_name)

# A commit needs a Change: trailer when it implements a proposed change — on a
# feature branch, or when it touches a requirement, whatever the branch is
# called. Mirrors the table in docs/git-guide.md; keep the two in step.
needs_change_trailer() {
	case "$BRANCH" in
	feat/*) return 0 ;;
	esac
	git diff --cached --name-only 2>/dev/null | grep -q '^openspec/specs/' && return 0
	return 1
}

if needs_change_trailer; then
	# --parse reads only the trailer block, so a body line that happens to start
	# with "Change:" is not mistaken for the declaration.
	CHANGE=$(git interpret-trailers --parse "$MSG_FILE" 2>/dev/null |
		sed -n 's/^Change: *//p' | head -n 1)
	if [ -z "$CHANGE" ]; then
		die "this commit needs a trailer naming the change it implements:
    Change: <openspec-change-id>
  It must sit in the trailer block at the end of the message, beside
  Co-Authored-By. Propose the change first if it does not exist (openspec-propose)."
	fi
	if [ ! -d "openspec/changes/$CHANGE" ] &&
		! ls -d "openspec/changes/archive/"*"-$CHANGE" >/dev/null 2>&1; then
		die "no OpenSpec change named '$CHANGE'.
  looked in: openspec/changes/$CHANGE
             openspec/changes/archive/<date>-$CHANGE"
	fi
fi

exit 0
