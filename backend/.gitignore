# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
env/
venv/
ENV/
.venv/

# Distribution / packaging
dist/
build/
*.egg-info/
.eggs/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Tool caches
.pytest_cache/
.ruff_cache/

# Logs directory (see app/logging/)
logs/

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Jupyter Notebook
.ipynb_checkpoints/

# Secrets: see config/.gitignore. config/.env is tracked on purpose — it only
# selects APP_ENV and holds no credentials.

# Local JSON data store (see docs/persistence-guide.md)
data/

# Editor & IDE settings
.idea/
.vscode/
*.swp
*~

# OS-specific files
.DS_Store
Thumbs.db

# Log files
*.log
